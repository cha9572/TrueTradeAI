# Local datasets: keep only the empty schema and directory placeholders.
# Generated TIGAS annotations, image files, metadata, caches and logs stay local.
data/*
!data/metadata.csv
!data/raw/
!data/processed/
!data/splits/
data/raw/*
data/processed/*
data/splits/*
!data/**/.gitkeep

# All experiment outputs, downloaded pretrained weights and trained checkpoints
