# Prevent accidentally adding dataset images outside data/ as well.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[wW][eE][bB][pP]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]

